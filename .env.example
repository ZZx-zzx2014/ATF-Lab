# ============================================================
# ATF Lab - 环境变量示例
#
# ⚠️ 仅供教学演示（EDUCATIONAL USE ONLY）
#
# 用法：
#   1. 复制本文件为 .env
#   2. 按需修改（尤其是生产环境的密钥）
#   .env 已被 .gitignore 排除，不会提交到仓库。
# ============================================================

# ---------------------------------------------------------- 服务
# 监听地址。默认 0.0.0.0 便于容器内访问；
# 若只在本机使用，建议改为 127.0.0.1 进一步收敛暴露面。
ATF_HOST=0.0.0.0
ATF_PORT=8899
# 调试模式，生产环境保持 0
ATF_DEBUG=0

# ---------------------------------------------------------- 绑定地址（公网部署）
# 控制 docker compose 把端口绑定到哪个网卡。
#   127.0.0.1  仅本机可访问（默认，最安全）
#   0.0.0.0    监听所有网卡（公网/局域网部署用）
# ⚠️ 改为 0.0.0.0 前，请先阅读 docs/PUBLIC_DEPLOY.md 的安全清单。
# ATF_BIND=127.0.0.1

# ---------------------------------------------------------- 数据库
# SQLite 数据库文件路径（相对路径以项目根目录为基准）
ATF_DB_PATH=data/atf.db

# ---------------------------------------------------------- 密钥
# ⚠️ 生产部署务必修改！可用以下命令生成：
#     openssl rand -hex 32
#     或 python -c "import secrets;print(secrets.token_hex(32))"
ATF_SECRET_KEY=change-me-in-production-please

# JWT 有效期（秒），默认 7 天
ATF_TOKEN_TTL=604800

# flag 校验用的 pepper。留空则从 SECRET_KEY 派生。
# 单独设置可以做到"改密钥不使已发 flag 失效"。
# ATF_FLAG_PEPPER=

# ---------------------------------------------------------- 初始管理员
# 首次启动时（用户表为空）会自动创建一个管理员账号。
#
# 密码来源：
#   1. 若设置了 ATF_ADMIN_PASSWORD，用它；
#   2. 否则随机生成一个 20 位强密码，并打印到启动日志。
# 无论哪种方式，都会被标记为"需要修改初始密码"，
# 站内每页顶部会显示红色警示横幅，直到管理员改密为止。
#
# 用户名留空则默认 admin。
ATF_ADMIN_USER=
ATF_ADMIN_PASSWORD=

# ---------------------------------------------------------- 跨域
# 前后端分离部署时，填写前端地址，多个用逗号分隔。
#
# ⚠️ 公网部署务必填具体域名，不要留 *
#    同域部署（默认，前端由后端托管）可以保持 *
ATF_CORS_ORIGINS=*

# ---------------------------------------------------------- 前端
# 前端构建产物目录。Docker 中为 /app/frontend/dist
ATF_FRONTEND_DIST=frontend/dist

# 前端 API 基地址（Vite 构建期注入）。
# 同域部署留空（使用相对路径 /api/v1/...）；
# 分离部署填完整地址，例如 https://api.example.com
# VITE_API_BASE=

# ---------------------------------------------------------- 仿真网络服务
# ⚠️ 只返回预置静态文本、仅监听回环地址、零出站连接。
#
# 下面是【容器内部】的监听端口，一般无需修改。
# 若系统占用了 3306 / 6379（如已安装 MySQL / Redis），
# 程序会自动回退到 13306 / 16379，实际端口可在 /api/v1/health 查看。
ATF_NETLAB_ENABLED=1
ATF_NETLAB_FTP_PORT=2121
ATF_NETLAB_MYSQL_PORT=3306
ATF_NETLAB_REDIS_PORT=6379
ATF_NETLAB_DEBUG_PORT=31337

# ---------------------------------------------------------- Docker 宿主端口映射
# 仅在使用 docker compose 时生效，映射到宿主机的端口。
# 默认值已规避常见冲突：
#   FTP   12121（2121 落在 Windows Hyper-V 保留区间 2061-2160）
#   MySQL 13306（避开宿主真实 MySQL 的 3306）
#   Redis 16379（避开宿主真实 Redis 的 6379）
# 冲突时改这里，或直接注释 docker-compose.yml 中对应的端口映射。
# ATF_HOST_FTP_PORT=12121
# ATF_HOST_MYSQL_PORT=13306
# ATF_HOST_REDIS_PORT=16379
# ATF_HOST_DEBUG_PORT=31337
